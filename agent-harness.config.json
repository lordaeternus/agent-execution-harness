{
  "schema_version": "agent_harness_config_v1",
  "artifact_dir": ".agent-harness/runs",
  "product_paths": [
    "src/",
    "tests/",
    "docs/"
  ],
  "required_scripts": [],
  "doctor_profile": "generic",
  "command_policy": {
    "allow": [],
    "deny": [
      "DROP",
      "TRUNCATE",
      "git reset --hard",
      "push --force",
      "force-with-lease"
    ],
    "strict_requires_allowed_command": true,
    "strict_disallow_shell": true
  }
}
