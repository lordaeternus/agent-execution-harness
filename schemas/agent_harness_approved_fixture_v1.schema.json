{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_harness_approved_fixture_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "surface", "owner_approved", "validator_command", "cases"],
  "properties": {
    "schema_version": { "const": "agent_harness_approved_fixture_v1" },
    "fixture_id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$" },
    "surface": { "type": "string", "minLength": 1 },
    "owner_approved": { "const": true },
    "validator_command": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expected_output"],
        "properties": {
          "input": {},
          "expected_output": {}
        }
      }
    }
  }
}
