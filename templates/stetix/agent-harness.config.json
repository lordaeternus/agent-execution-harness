{
  "schema_version": "agent_harness_config_v1",
  "artifact_dir": ".checks/agent-harness-runs",
  "product_paths": [
    "src/",
    "supabase/"
  ],
  "required_scripts": [
    "agent:harness",
    "agent:plan:lint",
    "agent:execute",
    "agent:report",
    "agent:harness:doctor",
    "governance:test"
  ],
  "doctor_profile": "stetix",
  "token_budget": {
    "observation_format": "ultra_compact",
    "summary_max_chars": 240,
    "output_excerpt_max_chars": 600,
    "report_compact_max_chars": 1600
  },
  "codebase_memory": {
    "enabled": true,
    "memory_dir": ".checks/agent-harness-memory",
    "default_strategy": "query",
    "stale_after_days": 14,
    "max_summary_chars": 1200,
    "surface_budgets": {
      "auth": 1800,
      "db": 1800,
      "api": 1400,
      "ai": 1400,
      "ui": 900,
      "ui_layout": 900,
      "docs": 500,
      "generic": 700,
      "backend": 900
    },
    "high_risk_surfaces": [
      "auth",
      "db",
      "api",
      "ai"
    ]
  },
  "learning_memory": {
    "enabled": true,
    "memory_dir": ".checks/agent-harness-learning",
    "top_k": 3,
    "ttl_days": 60,
    "max_summary_chars": 500,
    "max_lessons_per_surface": 20,
    "audit_cooldown_days": 7,
    "audit_max_lessons": 50,
    "audit_max_stale_ratio": 0.25,
    "audit_max_low_confidence_ratio": 0.2,
    "audit_max_duplicate_candidates": 5,
    "audit_compact_max_chars": 600
  },
  "command_policy": {
    "allow": [],
    "strict_requires_allowed_command": true,
    "strict_disallow_shell": true,
    "deny": [
      "DROP",
      "TRUNCATE",
      "UPDATE",
      "DELETE",
      "git reset --hard",
      "push --force",
      "force-with-lease"
    ]
  },
  "weak_model": {
    "enabled": true,
    "max_files_per_task": 2,
    "max_claims_per_action": 8,
    "summary_max_chars": 180,
    "output_excerpt_max_chars": 360,
    "repair_hint_max_chars": 280,
    "next_output_format": "ultra_compact"
  }
}
